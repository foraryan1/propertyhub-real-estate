MONGODB_URI=mongodb+srv://<database-user>:<database-password>@<cluster-host>/
MONGODB_DB=propertyhub
PORT=4000
# Local Vite origin. In Render, the frontend and API share an origin.
CLIENT_ORIGIN=http://localhost:5173

# Optional manager account. Use a unique password of at least 12 characters.
MANAGER_EMAIL=
MANAGER_PASSWORD=
